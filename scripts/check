#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

git diff --check
git diff --cached --check
python3 scripts/check_repository.py
python3 -m unittest discover -s scripts -p 'test_*.py'
echo "Repository checks passed."

if [[ ! -x gradlew ]]; then
    echo "Android checks require an executable Gradle Wrapper at ./gradlew." >&2
    exit 1
fi
./gradlew check assembleDebug assembleDebugAndroidTest

if [[ -n "${GOULE_UI_DEVICE:-}" ]]; then
    ./scripts/check-ui
fi
